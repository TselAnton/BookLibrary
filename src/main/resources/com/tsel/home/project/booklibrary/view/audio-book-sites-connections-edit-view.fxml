<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:id="mainAnchorPane" prefWidth="484" prefHeight="675" onKeyPressed="#stageKeyPressed" fx:controller="com.tsel.home.project.booklibrary.controller.impl.audiobook.AudioBookSiteConnectionEditSiteController">
    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox fx:id="windowHeader" styleClass="window-header" minHeight="56" prefHeight="56" maxHeight="56"/>
        <VBox VBox.vgrow="ALWAYS" styleClass="audio-table-container">
            <TableView fx:id="audioBookSiteTable" VBox.vgrow="ALWAYS"/>
        </VBox>
        <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="dialog-footer">
            <Button fx:id="cancelButton" text="Отмена" onAction="#cancelChanges"/>
            <Button fx:id="saveButton" text="Сохранить" styleClass="primary" onAction="#saveConnections"/>
        </HBox>
    </VBox>
</AnchorPane>
