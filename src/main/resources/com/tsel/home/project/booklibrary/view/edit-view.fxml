<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import com.tsel.home.project.booklibrary.ui.LineIcon?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:id="mainAnchorPane" prefWidth="484" prefHeight="675" onKeyPressed="#stageKeyPressed" fx:controller="com.tsel.home.project.booklibrary.controller.impl.book.EditBookController">
    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox fx:id="windowHeader" styleClass="window-header" minHeight="56" prefHeight="56" maxHeight="56"/>
        <GridPane hgap="12" styleClass="form-grid">
            <padding>
                <Insets top="12" left="16" right="16"/>
            </padding>
            <columnConstraints>
                <ColumnConstraints minWidth="154" prefWidth="154"/>
                <ColumnConstraints minWidth="0" prefWidth="286" maxWidth="286" hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
                <RowConstraints minHeight="35" prefHeight="35" maxHeight="35"/>
            </rowConstraints>
            <Label text="Название *" labelFor="$nameTextFieldInput" GridPane.rowIndex="0" styleClass="form-label"/>
            <TextField minWidth="0" fx:id="nameTextFieldInput" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Автор *" labelFor="$authorComboBox" GridPane.rowIndex="1" styleClass="form-label"/>
            <ComboBox fx:id="authorComboBox" editable="true" promptText="Выберите или введите" minWidth="0" prefWidth="286" maxWidth="286" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Издатель *" labelFor="$publisherComboBox" GridPane.rowIndex="2" styleClass="form-label"/>
            <ComboBox fx:id="publisherComboBox" editable="true" promptText="Выберите или введите" minWidth="0" prefWidth="286" maxWidth="286" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Количество страниц *" labelFor="$pagesCountFieldInput" GridPane.rowIndex="3" styleClass="form-label"/>
            <TextField minWidth="0" fx:id="pagesCountFieldInput" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Год издания *" labelFor="$publicationYearFieldInput" GridPane.rowIndex="4" styleClass="form-label"/>
            <TextField minWidth="0" fx:id="publicationYearFieldInput" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Твёрдая обложка" labelFor="$hardCoverCheckBox" GridPane.rowIndex="5" styleClass="form-label"/>
            <CheckBox fx:id="hardCoverCheckBox" selected="true" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label text="Прочитано" labelFor="$readCheckBox" GridPane.rowIndex="6" styleClass="form-label"/>
            <CheckBox fx:id="readCheckBox" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            <Label text="Автограф" labelFor="$autographCheckBox" GridPane.rowIndex="7" styleClass="form-label"/>
            <CheckBox fx:id="autographCheckBox" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
            <Label text="Жанр" labelFor="$genreComboBox" GridPane.rowIndex="8" styleClass="form-label"/>
            <ComboBox fx:id="genreComboBox" editable="true" promptText="Не выбран" minWidth="0" prefWidth="286" maxWidth="286" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
            <Label text="Цикл" labelFor="$cycleComboBox" GridPane.rowIndex="9" styleClass="form-label"/>
            <ComboBox fx:id="cycleComboBox" editable="true" promptText="Не выбран" minWidth="0" prefWidth="286" maxWidth="286" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
            <Label text="Завершённый цикл" labelFor="$cycleEndedCheckBox" GridPane.rowIndex="10" styleClass="form-label"/>
            <CheckBox fx:id="cycleEndedCheckBox" GridPane.rowIndex="10" GridPane.columnIndex="1"/>
            <Label text="Номер в цикле" labelFor="$numberInCycleFieldInput" GridPane.rowIndex="11" styleClass="form-label"/>
            <HBox alignment="CENTER_LEFT" GridPane.rowIndex="11" GridPane.columnIndex="1">
                <TextField minWidth="0" fx:id="numberInCycleFieldInput" prefWidth="124" accessibleText="Номер в цикле"/>
                <Label text="из" alignment="CENTER" minWidth="38"/>
                <TextField minWidth="0" fx:id="totalCountInCycleFieldInput" prefWidth="124" accessibleText="Количество книг в цикле"/>
            </HBox>
            <Label text="Обложка" labelFor="$coverImagePathFieldInput" GridPane.rowIndex="12" styleClass="form-label"/>
            <HBox alignment="CENTER_LEFT" spacing="8" minWidth="0" GridPane.rowIndex="12" GridPane.columnIndex="1">
                <TextField minWidth="0" fx:id="coverImagePathFieldInput" editable="true" promptText="Файл не выбран" HBox.hgrow="ALWAYS"/>
                <Button fx:id="selectCoverFileButton" onAction="#chooseBookCover" styleClass="icon-button, cover-browse" accessibleText="Выбрать обложку">
                    <graphic>
                        <LineIcon name="folder"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Выбрать обложку"/>
                    </tooltip>
                </Button>
            </HBox>
            <Label text="Стоимость *" labelFor="$priceFieldInput" GridPane.rowIndex="13" styleClass="form-label"/>
            <HBox alignment="CENTER_LEFT" styleClass="price-input" minWidth="0" GridPane.rowIndex="13" GridPane.columnIndex="1">
                <TextField minWidth="0" fx:id="priceFieldInput" HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="currency-suffix"><LineIcon name="ruble"/></StackPane>
            </HBox>
        </GridPane>
        <VBox minHeight="40" prefHeight="40" styleClass="form-status">
            <Label fx:id="validationStatus" styleClass="error-message" maxWidth="Infinity"/>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <HBox styleClass="dialog-footer" alignment="CENTER_LEFT" spacing="8">
            <Button fx:id="saveBookButton" text="Сохранить" defaultButton="true" styleClass="primary" minWidth="150" onAction="#editBook"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="exitButton" text="Отмена" minWidth="100" onAction="#cancelEditing"/>
        </HBox>
    </VBox>
</AnchorPane>
