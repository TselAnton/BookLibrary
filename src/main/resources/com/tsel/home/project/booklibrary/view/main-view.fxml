<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import com.tsel.home.project.booklibrary.ui.LineIcon?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:id="mainAnchorPane" prefWidth="1252" prefHeight="700" stylesheets="@../css/filters.css" fx:controller="com.tsel.home.project.booklibrary.controller.impl.MainViewController">
    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox fx:id="windowHeader" styleClass="window-header" minHeight="56" prefHeight="56" maxHeight="56"/>
        <MenuBar>
            <menus>
                <Menu text="Файлы">
                    <items>
                        <MenuItem fx:id="exportDataItem" text="Экспортировать данные" onAction="#exportData"/>
                        <MenuItem text="Открыть директорию проекта" onAction="#openApplicationDirectory"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Выход" onAction="#exitApplication"/>
                    </items>
                </Menu>
                <Menu text="Правка">
                    <items>
                        <MenuItem text="Редактировать циклы" onAction="#editCycles"/>
                        <MenuItem text="Редактировать авторов" onAction="#editAuthors"/>
                        <MenuItem text="Редактировать жанры" onAction="#editGenres"/>
                        <MenuItem text="Редактировать публицистов" onAction="#editPublishers"/>
                    </items>
                </Menu>
                <Menu text="Справка">
                    <items>
                        <MenuItem text="Проверить обновления" disable="true"/>
                        <MenuItem text="О программе" onAction="#showAbout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
        <HBox minHeight="52" prefHeight="52" spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
            <Button fx:id="addBookButton" text="Добавить книгу" styleClass="primary" onAction="#addBook">
                <graphic>
                    <LineIcon name="plus"/>
                </graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="filtersButton" text="Фильтры" onAction="#toggleFilters">
                <graphic>
                    <LineIcon name="filter"/>
                </graphic>
            </Button>
            <Button fx:id="priceButton" styleClass="icon-button" accessibleText="Стоимость книг" onAction="#showBooksPrice">
                <graphic>
                    <LineIcon name="ruble"/>
                </graphic>
            </Button>
            <Button fx:id="randomBookButton" styleClass="icon-button" accessibleText="Случайная непрочитанная книга" onAction="#chooseRandomBook">
                <graphic>
                    <LineIcon name="dice"/>
                </graphic>
            </Button>
        </HBox>
        <VBox fx:id="activeFilterContainer"/>
        <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
            <TableView fx:id="bookTableView" editable="false" onKeyPressed="#tableViewKeyPressed" onMouseClicked="#clickOnTable" onSort="#onSort" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="imageColumn" text="" prefWidth="36" minWidth="20" sortable="false"/>
                    <TableColumn fx:id="numberColumn" text="№" prefWidth="40" minWidth="20" sortable="false"/>
                    <TableColumn fx:id="nameColumn" text="Название" prefWidth="268" minWidth="20"/>
                    <TableColumn fx:id="authorColumn" text="Автор" prefWidth="190" minWidth="20"/>
                    <TableColumn fx:id="publisherColumn" text="Издание" prefWidth="90" minWidth="20"/>
                    <TableColumn fx:id="cycleColumn" text="Цикл" prefWidth="180" minWidth="20"/>
                    <TableColumn fx:id="cycleNumberColumn" text="Номер" prefWidth="80" minWidth="20" sortable="false"/>
                    <TableColumn fx:id="cycleEndColumn" text="Завершён" prefWidth="88" minWidth="20"/>
                    <TableColumn fx:id="readColumn" text="Прочитано" prefWidth="88" minWidth="20"/>
                    <TableColumn fx:id="pagesColumn" text="Страницы" prefWidth="80" minWidth="20"/>
                </columns>
            </TableView>
        </VBox>
        <HBox minHeight="28" prefHeight="28" alignment="CENTER_LEFT" styleClass="status-footer">
            <Label fx:id="resultStatus" text="Нет книг"/>
        </HBox>
    </VBox>
</AnchorPane>
