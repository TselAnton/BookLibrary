<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:id="mainAnchorPane" prefWidth="812" prefHeight="600" onKeyPressed="#stageKeyPressed" fx:controller="com.tsel.home.project.booklibrary.controller.impl.book.BookInfoViewController">
    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox fx:id="windowHeader" styleClass="window-header" minHeight="56" prefHeight="56" maxHeight="56"/>
        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="16" left="16" right="16"/>
            </padding>
            <VBox alignment="TOP_CENTER" spacing="8" minWidth="244" prefWidth="244">
                <StackPane minHeight="370" prefHeight="370" maxHeight="370" styleClass="cover-surface">
                    <ImageView fx:id="coverImage" fitWidth="244" fitHeight="370" preserveRatio="true"/>
                </StackPane>
            </VBox>
            <GridPane hgap="12" HBox.hgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints minWidth="190" prefWidth="190"/>
                    <ColumnConstraints prefWidth="314" hgrow="ALWAYS"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                    <RowConstraints minHeight="34" prefHeight="34" maxHeight="34"/>
                </rowConstraints>
                <Label text="Название" styleClass="detail-key" GridPane.rowIndex="0"/>
                <Label fx:id="nameLabel" text="—" maxWidth="Infinity" styleClass="book-name" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Автор" styleClass="detail-key" GridPane.rowIndex="1"/>
                <Label fx:id="authorLabel" text="—" maxWidth="Infinity" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Издатель" styleClass="detail-key" GridPane.rowIndex="2"/>
                <Label fx:id="publisherLabel" text="—" maxWidth="Infinity" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Количество страниц" styleClass="detail-key" GridPane.rowIndex="3"/>
                <Label fx:id="pageCountLabel" text="—" maxWidth="Infinity" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Год издания" styleClass="detail-key" GridPane.rowIndex="4"/>
                <Label fx:id="publicationYearLabel" text="—" maxWidth="Infinity" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label text="Жанр" styleClass="detail-key" GridPane.rowIndex="5"/>
                <Label fx:id="genreLabel" text="—" maxWidth="Infinity" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                <Label text="Твёрдая обложка" styleClass="detail-key" GridPane.rowIndex="6"/>
                <Label fx:id="hardCoverLabel" text="—" maxWidth="Infinity" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                <Label text="Прочитано" styleClass="detail-key" GridPane.rowIndex="7"/>
                <Label fx:id="readLabel" text="—" maxWidth="Infinity" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                <Label text="Автограф" styleClass="detail-key" GridPane.rowIndex="8"/>
                <Label fx:id="autographLabel" text="—" maxWidth="Infinity" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                <Label text="Стоимость" styleClass="detail-key" GridPane.rowIndex="9"/>
                <Label fx:id="priceLabel" text="—" maxWidth="Infinity" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                <Label text="Цикл" styleClass="detail-key" GridPane.rowIndex="10"/>
                <Label fx:id="cycleLabel" text="—" maxWidth="Infinity" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="10"/>
                <Label text="Цикл завершён" styleClass="detail-key" GridPane.rowIndex="11"/>
                <Label fx:id="cycleEndedLabel" text="—" maxWidth="Infinity" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="11"/>
            </GridPane>
        </HBox>
        <HBox styleClass="dialog-footer" alignment="CENTER_LEFT" spacing="8">
            <Button fx:id="editBookButton" text="Изменить" styleClass="primary" onAction="#editBook"/>
            <Button fx:id="deleteBookButton" text="Удалить" onAction="#deleteBook"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeBookButton" text="Закрыть" onAction="#closeWindow"/>
        </HBox>
    </VBox>
</AnchorPane>
