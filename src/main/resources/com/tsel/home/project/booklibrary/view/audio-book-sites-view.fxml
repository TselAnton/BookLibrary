<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:id="mainAnchorPane" prefWidth="400" prefHeight="608" onKeyPressed="#stageKeyPressed" fx:controller="com.tsel.home.project.booklibrary.controller.impl.audiobook.AudioBookSiteController">
    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox fx:id="windowHeader" styleClass="window-header" minHeight="56" prefHeight="56" maxHeight="56"/>
        <VBox VBox.vgrow="ALWAYS" styleClass="audio-table-container">
            <TableView fx:id="audioBookSiteTable" VBox.vgrow="ALWAYS"/>
        </VBox>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="dialog-footer">
            <TextField fx:id="addAudioBookSiteTextField" promptText="Название сайта" accessibleText="Название сайта аудиокниг" HBox.hgrow="ALWAYS" minWidth="0"/>
            <Button fx:id="addAudioBookSiteButton" text="Добавить" styleClass="primary" onAction="#addAudioBookSite"/>
        </HBox>
    </VBox>
</AnchorPane>
